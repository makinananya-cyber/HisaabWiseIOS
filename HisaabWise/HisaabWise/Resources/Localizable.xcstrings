    "registration.two.security.hint": {
      "comment": "The hint under the security questions heading.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا فقدت يومًا إمكانية الوصول إلى بريدك وهاتفك، فهاتان الإجابتان هما كيف نعرف أنك أنت حقًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you ever lose access to your email and phone, these two answers are how we know it's really you."
          }
