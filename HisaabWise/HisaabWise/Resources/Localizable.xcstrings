{
  "sourceLanguage": "en",
  "strings": {
    "component.button.inFlight": {
      "comment": "Read as a button's accessibility value while its action is in flight. The spinner that replaces the label is invisible to VoiceOver, so without this the control goes silent exactly when it is busy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In progress"
          }
        }
      }
    },
    "component.field.revealPassword": {
      "comment": "The eye button inside a password field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show password"
          }
        }
      }
    },
    "component.sheet.close": {
      "comment": "The close affordance in every sheet's header. Icon-only, so this is the whole of what VoiceOver reads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "home.empty": {
      "comment": "Home, when the server has figures for no months yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to show yet."
          }
        }
      }
    },
    "home.income.accessibilityLabel": {
      "comment": "VoiceOver label for the income figure. %@ is the server-formatted amount and is never reformatted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income %@"
          }
        }
      }
    },
    "home.income.label": {
      "comment": "Caption above the income figure on Home.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income"
          }
        }
      }
    },
    "landing.cta": {
      "comment": "Landing's primary call to action; opens sign-in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Started"
          }
        }
      }
    },
    "landing.free": {
      "comment": "Landing footnote under the call to action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free to start · No card required"
          }
        }
      }
    },
    "landing.headline.first": {
      "comment": "Landing headline, first line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know your money."
          }
        }
      }
    },
    "landing.headline.second": {
      "comment": "Landing headline, second line — drawn in the sky gradient.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grow your future."
          }
        }
      }
    },
    "landing.hero.accessibilityLabel": {
      "comment": "VoiceOver label for the landing hero illustration — the design's own aria-label, verbatim.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An open book resting on an open hand, with growth bars rising from one page and a coin above the other"
          }
        }
      }
    },
    "landing.strapline.1": {
      "comment": "Landing strapline 1 of 4. [FIX] Product Spec §3.1 — the design said “Every rupee”, which names a currency the app does not display; the line is currency-neutral instead.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every expense, tracked without thinking about it."
          }
        }
      }
    },
    "landing.strapline.2": {
      "comment": "Landing strapline 2 of 4.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See where your money goes — then decide where it should."
          }
        }
      }
    },
    "landing.strapline.3": {
      "comment": "Landing strapline 3 of 4.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save smarter, not harder."
          }
        }
      }
    },
    "landing.strapline.4": {
      "comment": "Landing strapline 4 of 4.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn the habits that quietly build wealth."
          }
        }
      }
    },
    "landing.strapline.accessibilityLabel": {
      "comment": "VoiceOver label for the rotating strapline, so its text is read as a value rather than re-announcing a changed label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What HisaabWise does"
          }
        }
      }
    },
    "shell.logout.action": {
      "comment": "The log out control on Account, and the destructive action in its confirmation dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log out"
          }
        }
      }
    },
    "shell.logout.confirm.cancel": {
      "comment": "The cancel action in the log out confirmation dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay signed in"
          }
        }
      }
    },
    "shell.logout.confirm.message": {
      "comment": "Body of the log out confirmation dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays safe. You'll need your password to sign back in."
          }
        }
      }
    },
    "shell.logout.confirm.title": {
      "comment": "Title of the log out confirmation dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log out of HisaabWise?"
          }
        }
      }
    },
    "shell.mark.accessibilityLabel": {
      "comment": "VoiceOver label for the HisaabWise wordmark, which is an image.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HisaabWise"
          }
        }
      }
    },
    "shell.tab.account": {
      "comment": "Tab bar: the Account tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        }
      }
    },
    "shell.tab.expenses": {
      "comment": "Tab bar: the Expenses tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expenses"
          }
        }
      }
    },
    "shell.tab.home": {
      "comment": "Tab bar: the Home tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        }
      }
    },
    "shell.tab.learn": {
      "comment": "Tab bar: the Learn tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn"
          }
        }
      }
    },
    "shell.tab.reports": {
      "comment": "Tab bar: the Reports tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports"
          }
        }
      }
    },
    "shell.unwritten.note": {
      "comment": "Placeholder body on a tab whose screen has not been written yet, and on the Landing placeholder. Deleted with the ticket that writes the screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen is not built yet."
          }
        }
      }
    },
    "signin.action": {
      "comment": "Sign-in submit button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In"
          }
        }
      }
    },
    "signin.email.label": {
      "comment": "Sign-in email field label. [FIX] Product Spec §3.2 — the design asked for a username, which registration never collects.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        }
      }
    },
    "signin.email.placeholder": {
      "comment": "Sign-in email field placeholder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "you@example.com"
          }
        }
      }
    },
    "signin.error.emailMissing": {
      "comment": "Sign-in validation: the email box is empty.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter your email."
          }
        }
      }
    },
    "signin.error.passwordMissing": {
      "comment": "Sign-in validation: the password box is empty.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter your password."
          }
        }
      }
    },
    "signin.error.passwordTooShort": {
      "comment": "Sign-in validation: password under 8 characters. [FIX] the design's sign-in accepted 6; invariant 4 is 8+ everywhere.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least 8 characters."
          }
        }
      }
    },
    "signin.error.refused": {
      "comment": "Sign-in failure. Deliberately identical whether or not the account exists, so the response cannot be used to discover which addresses are registered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email and password do not match. Check both and try again."
          }
        }
      }
    },
    "signin.error.support": {
      "comment": "Sign-in hint after three refused attempts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still not working? Contact support and we'll help you back in."
          }
        }
      }
    },
    "signin.forgot": {
      "comment": "Sign-in link to the password reset flow.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgot password?"
          }
        }
      }
    },
    "signin.keepSignedIn": {
      "comment": "Sign-in checkbox; checked by default. Decides whether the refresh token goes to the Keychain or to memory.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep me signed in"
          }
        }
      }
    },
    "signin.password.label": {
      "comment": "Sign-in password field label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        }
      }
    },
    "signin.pendingDeletion.action": {
      "comment": "Sign-in: the restore path out of pending deletion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore my account"
          }
        }
      }
    },
    "signin.pendingDeletion.title": {
      "comment": "Sign-in: the account is inside its 30-day grace period.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is scheduled for deletion."
          }
        }
      }
    },
    "signin.register.action": {
      "comment": "Sign-in button to registration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an account"
          }
        }
      }
    },
    "signin.register.prompt": {
      "comment": "Sign-in prompt above the register button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you new here?"
          }
        }
      }
    },
    "signin.subtitle": {
      "comment": "Sign-in subtitle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to pick up your spending, savings and streaks."
          }
        }
      }
    },
    "signin.title.first": {
      "comment": "Sign-in headline, first line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome back."
          }
        }
      }
    },
    "signin.title.second": {
      "comment": "Sign-in headline, second line — drawn in the sky gradient.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's get you in."
          }
        }
      }
    },
    "state.failed.generic": {
      "comment": "Every failure whose code this build does not recognise. Never the server's own message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again."
          }
        }
      }
    },
    "state.failed.malformedResponse": {
      "comment": "The server answered with a body the app could not read. Our bug, not the user's.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't read the server's answer. Try again."
          }
        }
      }
    },
    "state.failed.monthClosed": {
      "comment": "MONTH_CLOSED — the month has been archived since the screen was opened.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That month has closed. Reload to see the current one."
          }
        }
      }
    },
    "state.failed.rateLimited": {
      "comment": "RATE_LIMITED — too many requests in the window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many tries. Wait a moment, then try again."
          }
        }
      }
    },
    "state.loading": {
      "comment": "Shared across every screen: a request is in flight. Read aloud beside the spinner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        }
      }
    },
    "state.offline": {
      "comment": "Shared across every screen: the device cannot reach the server. Offline is a supported mode, not a fault, so this must not read as one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Reconnect and we'll fetch your figures."
          }
        }
      }
    },
    "state.retry": {
      "comment": "The retry CTA on the offline and failed states.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    }
  },
  "version": "1.0"
}
