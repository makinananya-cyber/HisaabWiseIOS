    "signin.error.emailMissing": {
      "comment": "Sign-in validation: the email box is empty.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى إدخال بريدك الإلكتروني."
          }
