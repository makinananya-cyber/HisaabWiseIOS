    "home.goalNudge.action": {
      "comment": "Button that accepts the suggested savings goal. Kept short so it sits beside 'Not now' without wrapping in the card.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفع الهدف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise goal"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य बढ़ाएँ"
          }
        }
      }
    },
    "home.goalNudge.body %@ %@": {
      "comment": "Suggests raising the savings goal to a fifth of the new salary. %1$@ is the suggested amount, %2$@ the current goal — both server-formatted display strings (ADR-0003).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خُمس راتبك الآن %1$@، لكن هدفك ما زال %2$@. رفعه يُبقي مدخراتك تنمو مع راتبك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fifth of your pay is now %1$@, but your goal is still %2$@. Raising it keeps your savings growing with your salary."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके वेतन का पाँचवाँ हिस्सा अब %1$@ है, लेकिन आपका लक्ष्य अब भी %2$@ है। इसे बढ़ाने से आपकी बचत आपके वेतन के साथ बढ़ती रहती है।"
          }
        }
      }
    },
    "home.goalNudge.dismiss": {
      "comment": "Button that leaves the savings goal alone. A goal is the reader's to choose.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس الآن"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी नहीं"
          }
        }
      }
    },
    "home.goalNudge.title": {
      "comment": "Title of the card suggesting a higher savings goal after a pay rise.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
