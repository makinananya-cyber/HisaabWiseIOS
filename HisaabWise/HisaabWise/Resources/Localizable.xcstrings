    "reports.detail.note.adapted %@ %@": {
      "comment": "The sentence under a month's totals when the budget engine's adaptive branch ran: needs outgrew half the income, so what was left was split evenly rather than 30/20. %1$@ is what needs came to and %2$@ is what came in, both formatted server-side.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغ الإيجار والفواتير والطعام %1$@ — أكثر من نصف دخلك البالغ %2$@، لذا قُسِّم الباقي بالتساوي بين الرغبات والادخار."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rent, bills and food came to %1$@ — more than half your %2$@ income, so the rest was split evenly between wants and savings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किराया, बिल और भोजन मिलाकर %1$@ हुए — आपकी %2$@ आय के आधे से अधिक, इसलिए बाकी को इच्छाओं और बचत के बीच समान रूप से बाँटा गया।"
          }
        }
      }
    },
    "reports.detail.note.plain": {
      "comment": "The sentence under a month's totals when needs fitted inside half the income and the plain 50/30/20 rule held.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استوعب نصف دخلك احتياجاتك، لذا طُبِّقت قاعدة 50 / 30 / 20 كاملة ذلك الشهر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your needs fitted inside half your income, so the full 50 / 30 / 20 rule applied that month."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी ज़रूरतें आपकी आधी आय के भीतर आ गईं, इसलिए उस महीने पूरा 50 / 30 / 20 नियम लागू हुआ।"
          }
        }
      }
    },
