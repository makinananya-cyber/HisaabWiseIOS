{
  "sourceLanguage": "en",
  "strings": {
    "component.button.inFlight": {
      "comment": "Read as a button's accessibility value while its action is in flight. The spinner that replaces the label is invisible to VoiceOver, so without this the control goes silent exactly when it is busy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In progress"
          }
        }
      }
    },
    "component.combo.hint": {
      "comment": "VoiceOver hint on a picker trigger — the design's aria-haspopup=\"listbox\", said in words.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a list to choose from"
          }
        }
      }
    },
    "component.field.revealPassword": {
      "comment": "The eye button inside a password field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show password"
          }
        }
      }
    },
    "component.money.accessibilityEmpty %@": {
      "comment": "VoiceOver value for an empty money field. %@ is the ISO currency code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No amount yet, in %@"
          }
        }
      }
    },
    "component.money.accessibilityValue %@ %@": {
      "comment": "VoiceOver value for a money field: %1$@ is the number typed, %2$@ the ISO currency code. Numbered so a language can put the code first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "component.phone.accessibilityValue %@ %@": {
      "comment": "VoiceOver value for the dial-code trigger: %1$@ is the dial code, %2$@ the ISO country code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "component.picker.clearSearch": {
      "comment": "VoiceOver label for the button that empties a picker's search box.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear search"
          }
        }
      }
    },
    "component.picker.empty": {
      "comment": "The design's .empty state inside a picker sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing matched that search."
          }
        }
      }
    },
    "component.sheet.close": {
      "comment": "The close affordance in every sheet's header. Icon-only, so this is the whole of what VoiceOver reads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "component.strength.label": {
      "comment": "VoiceOver label for the password strength meter. The level is announced as its value.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password strength"
          }
        }
      }
    },
    "component.strength.none": {
      "comment": "VoiceOver value for the strength meter before anything has been typed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not rated yet"
          }
        }
      }
    },
    "home.empty": {
      "comment": "Home, when the server has figures for no months yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to show yet."
          }
        }
      }
    },
    "home.income.accessibilityLabel %@": {
      "comment": "VoiceOver label for the income figure. %@ is the server-formatted amount and is never reformatted. The key carries the specifier because that is what SwiftUI looks up for `Text(\"key \\(value)\")`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income %@"
          }
        }
      }
    },
    "home.income.label": {
      "comment": "Caption above the income figure on Home.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income"
          }
        }
      }
    },
    "landing.cta": {
      "comment": "Landing's primary call to action; opens sign-in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Started"
          }
        }
      }
    },
    "landing.free": {
      "comment": "Landing footnote under the call to action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free to start · No card required"
          }
        }
      }
    },
    "landing.headline.first": {
      "comment": "Landing headline, first line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know your money."
          }
        }
      }
    },
    "landing.headline.second": {
      "comment": "Landing headline, second line — drawn in the sky gradient.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grow your future."
          }
        }
      }
    },
    "landing.hero.accessibilityLabel": {
      "comment": "VoiceOver label for the landing hero illustration — the design's own aria-label, verbatim.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An open book resting on an open hand, with growth bars rising from one page and a coin above the other"
          }
        }
      }
    },
    "landing.strapline.1": {
      "comment": "Landing strapline 1 of 4. [FIX] Product Spec §3.1 — the design said “Every rupee”, which names a currency the app does not display; the line is currency-neutral instead.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every expense, tracked without thinking about it."
          }
        }
      }
    },
    "landing.strapline.2": {
      "comment": "Landing strapline 2 of 4.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See where your money goes — then decide where it should."
          }
        }
      }
    },
    "landing.strapline.3": {
      "comment": "Landing strapline 3 of 4.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save smarter, not harder."
          }
        }
      }
    },
    "landing.strapline.4": {
      "comment": "Landing strapline 4 of 4.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn the habits that quietly build wealth."
          }
        }
      }
    },
    "landing.strapline.accessibilityLabel": {
      "comment": "VoiceOver label for the rotating strapline, so its text is read as a value rather than re-announcing a changed label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What HisaabWise does"
          }
        }
      }
    },
    "registration.back.toDetails": {
      "comment": "VoiceOver label on the step-back control, from the design's own aria-label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to your details"
          }
        }
      }
    },
    "registration.back.toMoney": {
      "comment": "VoiceOver label on the step-back control from step 3, from the design's own aria-label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to your money details"
          }
        }
      }
    },
    "registration.confirmPassword.label": {
      "comment": "Registration step 1 field label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm password"
          }
        }
      }
    },
    "registration.country.search": {
      "comment": "Placeholder in the dial-code picker's search box. Matches a name, an ISO code, or a dial code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search country or code"
          }
        }
      }
    },
    "registration.country.title": {
      "comment": "Title of the dial-code picker sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select country code"
          }
        }
      }
    },
    "registration.dateOfBirth.label": {
      "comment": "Registration step 1 field label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date of birth"
          }
        }
      }
    },
    "registration.dateOfBirth.placeholder": {
      "comment": "Shown in the date field before a date has been chosen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your date of birth"
          }
        }
      }
    },
    "registration.email.label": {
      "comment": "Registration step 1 field label. Email is the identity (invariant 4).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email address"
          }
        }
      }
    },
    "registration.error.dateOfBirthMissing": {
      "comment": "Registration validation message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please choose your date of birth."
          }
        }
      }
    },
    "registration.error.emailInvalid": {
      "comment": "Registration validation message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid email address."
          }
        }
      }
    },
    "registration.error.emailTaken": {
      "comment": "Shown on the email field when the server refuses the registration because the address is taken. The only per-field failure registration can receive, and the only way the client learns an address is registered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That address already has an account. Sign in instead, or use another one."
          }
        }
      }
    },
    "registration.error.firstAnswerMissing": {
      "comment": "Registration validation message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please answer your first question."
          }
        }
      }
    },
    "registration.error.firstQuestionMissing": {
      "comment": "Registration validation message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your first question."
          }
        }
      }
    },
    "registration.error.goalMissing": {
      "comment": "Registration validation message on the goal field, reachable only through Submit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a goal, or tap Skip for now."
          }
        }
      }
    },
    "registration.error.nameMissing": {
      "comment": "Registration validation message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please tell us your name."
          }
        }
      }
    },
    "registration.error.passwordTooShort": {
      "comment": "Registration validation message. 8+ everywhere (invariant 4).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least 8 characters."
          }
        }
      }
    },
    "registration.error.passwordsDoNotMatch": {
      "comment": "Registration validation message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords don't match yet."
          }
        }
      }
    },
    "registration.error.phoneInvalid": {
      "comment": "Registration validation message. The number is optional at launch, which the message says so the field does not read as required.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid phone number, or leave it blank."
          }
        }
      }
    },
    "registration.error.salaryMissing": {
      "comment": "Registration validation message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your salary as a number."
          }
        }
      }
    },
    "registration.error.secondAnswerMissing": {
      "comment": "Registration validation message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please answer your second question."
          }
        }
      }
    },
    "registration.error.secondQuestionMissing": {
      "comment": "Registration validation message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a second question."
          }
        }
      }
    },
    "registration.error.secondQuestionRepeated": {
      "comment": "Registration validation message. The picker already omits the other slot's question; this covers the two slots being filled in either order.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your two questions need to be different."
          }
        }
      }
    },
    "registration.error.termsNotAccepted": {
      "comment": "Registration validation message, drawn under the checkbox rather than in a toast.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please tick the Terms & Privacy Policy to continue."
          }
        }
      }
    },
    "registration.error.tooYoung": {
      "comment": "Registration validation message. The number matches RegistrationViewModel.minimumAge, which RegistrationCopyTests asserts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need to be at least 13 to open an account."
          }
        }
      }
    },
    "registration.name.label": {
      "comment": "Registration step 1 field label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full name"
          }
        }
      }
    },
    "registration.one.action": {
      "comment": "The button that validates step 1 and moves to step 2. It creates nothing — the account is created at the end of step 3.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register"
          }
        }
      }
    },
    "registration.one.stepLabel": {
      "comment": "The design's .steplab. A whole sentence rather than two interpolated numbers, so a translation owns the word order.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 1 of 3"
          }
        }
      }
    },
    "registration.one.subtitle": {
      "comment": "Registration step 1 subtitle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First the basics — this is all we need to open your account."
          }
        }
      }
    },
    "registration.one.title.first": {
      "comment": "Registration step 1 headline, first line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start in a minute."
          }
        }
      }
    },
    "registration.one.title.second": {
      "comment": "Registration step 1 headline, emphasised second line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build the habit for life."
          }
        }
      }
    },
    "registration.password.label": {
      "comment": "Registration step 1 field label. 8+ characters everywhere (invariant 4).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create password"
          }
        }
      }
    },
    "registration.password.strength.fair": {
      "comment": "Password strength meter level 2 of 4.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fair"
          }
        }
      }
    },
    "registration.password.strength.good": {
      "comment": "Password strength meter level 3 of 4.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good"
          }
        }
      }
    },
    "registration.password.strength.strong": {
      "comment": "Password strength meter level 4 of 4.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strong"
          }
        }
      }
    },
    "registration.password.strength.weak": {
      "comment": "Password strength meter level 1 of 4. Feedback only; nothing is refused for being weak.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weak"
          }
        }
      }
    },
    "registration.phone.dial.accessibilityLabel": {
      "comment": "VoiceOver label on the dial-code trigger, from the design's own aria-label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change country code"
          }
        }
      }
    },
    "registration.phone.label": {
      "comment": "Registration step 1 field label. Optional at launch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone number"
          }
        }
      }
    },
    "registration.reference.retry": {
      "comment": "Asks for the currency, country, and question lists again after they would not load.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "registration.signIn.action": {
      "comment": "Goes back to sign-in from registration step 1.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in instead"
          }
        }
      }
    },
    "registration.signIn.prompt": {
      "comment": "The prompt above the way back to sign-in, on registration step 1.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already with us? Welcome back!"
          }
        }
      }
    },
    "registration.terms": {
      "comment": "The consent checkbox on registration step 1. A blocker, not a preference.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I agree to the Terms & Privacy Policy"
          }
        }
      }
    },
    "registration.terms.privacy": {
      "comment": "Opens the hosted Privacy Policy page beside the consent checkbox.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the Privacy Policy"
          }
        }
      }
    },
    "registration.terms.terms": {
      "comment": "Opens the hosted Terms of Use page beside the consent checkbox.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the Terms"
          }
        }
      }
    },
    "registration.three.action": {
      "comment": "The button that creates the account — the one atomic POST /v1/auth/register.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit"
          }
        }
      }
    },
    "registration.three.goal.label": {
      "comment": "Registration step 3 field label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly savings goal"
          }
        }
      }
    },
    "registration.three.hint.above %@": {
      "comment": "The hint when the typed goal is above the suggestion. %@ is the whole-number percentage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's %@%% of your salary — ahead of the 20%% rule. Nice."
          }
        }
      }
    },
    "registration.three.hint.below %@": {
      "comment": "The hint when the typed goal is below the suggestion. %@ is the whole-number percentage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's %@%% of your salary — a little under the 20%% rule, but a start is a start."
          }
        }
      }
    },
    "registration.three.hint.empty": {
      "comment": "The hint under the goal field when nothing has been typed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this blank and tap Skip for now to use the suggested amount."
          }
        }
      }
    },
    "registration.three.hint.onTarget %@": {
      "comment": "The hint when the typed goal is exactly the suggestion. %@ is the whole-number percentage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's %@%% of your salary — right on the rule."
          }
        }
      }
    },
    "registration.three.perMonth": {
      "comment": "Follows the suggested figure on the statement card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a month"
          }
        }
      }
    },
    "registration.three.rule.body": {
      "comment": "Body of the 20% statement card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A well-tested rule of thumb is to put 20% of your salary towards savings each month. Based on the salary you gave us, that comes to:"
          }
        }
      }
    },
    "registration.three.rule.eyebrow": {
      "comment": "Eyebrow on the statement card explaining the suggested savings goal.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
