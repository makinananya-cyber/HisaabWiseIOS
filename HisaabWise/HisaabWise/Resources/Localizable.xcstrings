    "expenses.wants.accessibilityValue.over %@ %@ %@": {
      "comment": "The same sentence when the budget has been passed. A whole sentence rather than a clause appended, so a translation can reorder it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
