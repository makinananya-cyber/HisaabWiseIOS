      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشهر الذي كنت تضيف إليه تم أرشفته. أتريد إضافة هذا إلى %@ بدلًا منه؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month you were adding to has been filed away. Add this to %@ instead?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस महीने में आप जोड़ रहे थे उसे संग्रहित कर दिया गया है। क्या इसके बजाय इसे %@ में जोड़ें?"
          }
        }
      }
    },
