            "state": "translated",
            "value": "वे दोनों मेल नहीं खाते।"
          }
        }
      }
    },
    "recovery.error.ticketExpired": {
      "comment": "The reset ticket was spent or expired between verifying and choosing a password.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق ذلك وقتًا طويلًا. أجب عن أسئلتك مرة أخرى للمتابعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That took too long. Answer your questions again to continue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें बहुत समय लग गया। जारी रखने के लिए अपने प्रश्नों के उत्तर फिर से दें।"
          }
        }
      }
    },
    "recovery.identity.action": {
      "comment": "Submit button on recovery step 2.",
      "extractionState": "manual",
      "localizations": {
