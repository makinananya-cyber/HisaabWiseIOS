    "recovery.support": {
      "comment": "Offered after three refused identity checks. The only thing left that helps somebody who cannot answer their own questions.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زلت عالقًا؟ تواصل مع الدعم وسنساعدك على إثبات ملكيتك للحساب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still stuck? Contact support and we will help you prove the account is yours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब भी अटके हैं? सहायता से संपर्क करें और हम यह साबित करने में आपकी मदद करेंगे कि खाता आपका है।"
          }
        }
      }
    },
