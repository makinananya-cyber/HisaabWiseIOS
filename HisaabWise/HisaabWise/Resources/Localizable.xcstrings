      }
    },
    "signin.title.first": {
      "comment": "Sign-in headline, first line.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أهلًا بعودتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome back."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वापसी पर स्वागत है।"
          }
        }
      }
    },
    "signin.title.second": {
      "comment": "Sign-in headline, second line — drawn in the sky gradient.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لندخلك إلى حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's get you in."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइए आपको अंदर ले चलें।"
          }
        }
      }
    },
    "state.failed.generic": {
      "comment": "Every failure whose code this build does not recognise. Never the server's own message.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما. حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ गड़बड़ हो गई। फिर से कोशिश करें।"
          }
        }
      }
    },
    "state.failed.malformedResponse": {
      "comment": "The server answered with a body the app could not read. Our bug, not the user's.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر علينا قراءة رد الخادم. حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't read the server's answer. Try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम सर्वर का उत्तर नहीं पढ़ सके। फिर से कोशिश करें।"
          }
        }
      }
    },
    "state.failed.monthClosed": {
      "comment": "MONTH_CLOSED — the month has been archived since the screen was opened.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلق ذلك الشهر. أعد التحميل لرؤية الشهر الحالي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That month has closed. Reload to see the current one."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह महीना बंद हो गया है। वर्तमान महीना देखने के लिए फिर से लोड करें।"
          }
        }
      }
    },
    "state.failed.rateLimited": {
      "comment": "RATE_LIMITED — too many requests in the window.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة جدًا. انتظر لحظة ثم حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many tries. Wait a moment, then try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत अधिक प्रयास। एक क्षण रुकें, फिर से कोशिश करें।"
          }
        }
      }
    },
    "state.loading": {
      "comment": "Shared across every screen: a request is in flight. Read aloud beside the spinner.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التحميل…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोड हो रहा है…"
          }
        }
      }
    },
    "state.offline": {
      "comment": "Shared across every screen: the device cannot reach the server. Offline is a supported mode, not a fault, so this must not read as one.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل. أعد الاتصال وسنجلب أرقامك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Reconnect and we'll fetch your figures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। फिर से कनेक्ट करें और हम आपके आँकड़े ले आएँगे।"
          }
        }
      }
    },
    "state.retry": {
      "comment": "The retry CTA on the offline and failed states.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول مرة أخرى"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से कोशिश करें"
          }
        }
      }
    }
  },
  "version": "1.1"
}
