          }
        }
      }
    },
    "account.password.questions.answer": {
      "comment": "The label on each answer box. The *question* is drawn above it, because a question is server content and a field's label is a catalogue key.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجابتك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका उत्तर"
          }
        }
      }
    },
    "account.password.questions.blurb": {
      "comment": "`.step-p` on step two. The design's sentence, with its promise kept by the server's normalisation (§4.3) rather than by a client-side comparison (defect D4).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذان هما السؤالان اللذان اخترتهما عند إعداد الحساب. لا تهم حالة الأحرف ولا الصياغة الدقيقة — يكفي أن تصيب الكلمات الأساسية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the two questions you chose when you set up the account. Capital letters and exact wording do not matter — just get the key words right."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये वे दो प्रश्न हैं जो आपने खाता सेट करते समय चुने थे। बड़े-छोटे अक्षर और सटीक शब्दावली मायने नहीं रखती — बस मुख्य शब्द सही रखें।"
          }
        }
      }
    },
    "account.password.questions.heading": {
      "comment": "`.step-h` on step two — the design's own words.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجب عن أسئلة الأمان"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer your security questions"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सुरक्षा प्रश्नों के उत्तर दें"
          }
        }
      }
    },
    "account.password.questions.support": {
      "comment": "Shown after three refusals — the design's own escape route, and the only thing left that helps somebody who cannot answer their own questions.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زلت عالقًا؟ تواصل مع الدعم وسنتحقق من هويتك بطريقة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still stuck? Contact support and we will check who you are another way."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब भी अटके हैं? सहायता से संपर्क करें और हम किसी और तरीके से आपकी पहचान की जाँच करेंगे।"
          }
        }
      }
    },
