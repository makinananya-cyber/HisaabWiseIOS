        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter your email."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया अपना ईमेल दर्ज करें।"
          }
        }
      }
    },
    "signin.error.passwordMissing": {
      "comment": "Sign-in validation: the password box is empty.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى إدخال كلمة مرورك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter your password."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया अपना पासवर्ड दर्ज करें।"
          }
        }
      }
    },
    "signin.error.passwordTooShort": {
      "comment": "Sign-in validation: password under 8 characters. [FIX] the design's sign-in accepted 6; invariant 4 is 8+ everywhere.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم 8 أحرف على الأقل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least 8 characters."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम 8 वर्णों का उपयोग करें।"
          }
        }
      }
    },
    "signin.error.refused": {
      "comment": "Sign-in failure. Deliberately identical whether or not the account exists, so the response cannot be used to discover which addresses are registered.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتطابق البريد الإلكتروني وكلمة المرور. تحقّق منهما وحاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email and password do not match. Check both and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह ईमेल और पासवर्ड मेल नहीं खाते। दोनों जाँचें और फिर से कोशिश करें।"
          }
        }
      }
    },
    "signin.error.support": {
      "comment": "Sign-in hint after three refused attempts.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال لا يعمل؟ تواصل مع الدعم وسنساعدك على العودة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still not working? Contact support and we'll help you back in."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब भी काम नहीं कर रहा? सहायता से संपर्क करें और हम आपको वापस अंदर आने में मदद करेंगे।"
          }
        }
      }
    },
    "signin.forgot": {
      "comment": "Sign-in link to the password reset flow.",
