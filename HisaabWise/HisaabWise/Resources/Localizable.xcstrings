            "state": "translated",
            "value": "Unit %1$@ · %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इकाई %1$@ · %2$@"
          }
        }
      }
    },
    "recovery.done.action": {
      "comment": "Button that returns to the sign-in form after a reset.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करें"
          }
        }
      }
    },
    "recovery.done.blurb": {
      "comment": "Blurb once the password has been reset. Says that other devices were signed out, because a recovery revokes every session in both directions.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الآن تسجيل الدخول بكلمة مرورك الجديدة. تم تسجيل خروج أي جهاز آخر كان مُسجَّل الدخول."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can sign in with your new password now. Any other device that was signed in has been signed out."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आप अपने नए पासवर्ड से साइन इन कर सकते हैं। जो भी अन्य डिवाइस साइन इन था, उसे साइन आउट कर दिया गया है।"
          }
        }
      }
    },
    "recovery.done.heading": {
      "comment": "Heading once the password has been reset.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إعادة تعيين كلمة المرور"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password reset"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड रीसेट हुआ"
          }
        }
      }
    },
    "recovery.email.action": {
      "comment": "Submit button on recovery step 1.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متابعة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखें"
          }
        }
      }
    },
    "recovery.email.blurb": {
      "comment": "Blurb of recovery step 1.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل البريد الإلكتروني الذي سجّلت به. سنعرض لك سؤالَي الأمان اللذين اخترتهما."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the email address you registered with. We will show you the two security questions you chose."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह ईमेल पता दर्ज करें जिससे आपने पंजीकरण किया था। हम आपको वे दो सुरक्षा प्रश्न दिखाएँगे जो आपने चुने थे।"
          }
        }
      }
    },
    "recovery.email.heading": {
      "comment": "Heading of recovery step 1.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أولًا، أي حساب؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First, which account?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले, कौन सा खाता?"
          }
        }
      }
    },
    "recovery.email.label": {
      "comment": "Email field on recovery step 1.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البريد الإلكتروني"
          }
        },
        "en": {
