          "stringUnit": {
            "state": "translated",
            "value": "अपनी जन्मतिथि चुनें।"
          }
        }
      }
    },
    "recovery.error.emailMissing": {
      "comment": "Recovery step 1 with an empty email box.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل البريد الإلكتروني الذي سجّلت به."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the email address you registered with."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह ईमेल पता दर्ज करें जिससे आपने पंजीकरण किया था।"
          }
        }
      }
    },
    "recovery.error.identityRefused": {
      "comment": "The server refused the identity check. Deliberately says nothing about WHICH factor missed — naming one would halve the work of guessing the other.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يطابق ذلك ما لدينا لهذا الحساب. تحقّق من إجاباتك وتاريخ ميلادك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That did not match what we hold for this account. Check your answers and your date of birth."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस खाते के लिए हमारे पास मौजूद जानकारी से मेल नहीं खाया। अपने उत्तर और अपनी जन्मतिथि जाँचें।"
          }
        }
      }
    },
    "recovery.error.locked": {
      "comment": "Too many failed recovery attempts. The server's backoff is authoritative.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة جدًا. انتظر قليلًا ثم حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait a little while and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत अधिक प्रयास। थोड़ी देर रुकें और फिर से कोशिश करें।"
          }
        }
      }
    },
    "recovery.error.passwordMissing": {
      "comment": "Recovery step 3 with an empty password box.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كلمة مرور جديدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a new password."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नया पासवर्ड चुनें।"
          }
        }
      }
    },
    "recovery.error.passwordTooShort": {
      "comment": "Recovery step 3 with a password under eight characters (invariant 4).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم 8 أحرف على الأقل."
          }
