            "state": "translated",
            "value": "Email"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ईमेल"
          }
        }
      }
    },
    "recovery.error.answerMissing": {
      "comment": "Recovery step 2 with an unanswered question. Covers both boxes: the message sits under the first one only.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجب عن السؤالين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
