    "signin.subtitle": {
      "comment": "Sign-in subtitle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول لمتابعة صرفك ومدخراتك وسلاسلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
