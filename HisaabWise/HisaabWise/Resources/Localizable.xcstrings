{
  "sourceLanguage": "en",
  "strings": {
    "account.currency.blurb": {
      "comment": "`.explain` over the currency list — the design's own sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُعرض المبالغ التي تُدخلها وكل إجمالي تراه بهذه العملة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amounts you enter and every total you see will use this currency."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो राशि दर्ज करेंगे और जो भी कुल आपको दिखेगा, वह इसी मुद्रा में होगा।"
          }
        }
      }
    },
    "account.currency.search": {
      "comment": "The currency list's search placeholder — the design's own words.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن عملة أو رمز"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search currency or code"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुद्रा या कोड खोजें"
          }
        }
      }
    },
    "account.currency.title": {
      "comment": "The Currency page's navigation title.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العملة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currency"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुद्रा"
          }
        }
      }
    },
    "account.delete.action": {
      "comment": "Button on the Account screen that begins account deletion. App Store 5.1.1(v) requires this to exist in-app.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف حسابي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete my account"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरा खाता हटाएँ"
          }
        }
      }
    },
    "account.delete.blurb": {
      "comment": "Explains what deletion does, under the button. The grace period is 30 days (ADR-0015).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُجدوَل بياناتك للحذف وتُمحى بعد 30 يومًا. سجّل الدخول خلال 30 يومًا لاستعادتها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is scheduled for deletion and erased after 30 days. Sign in within 30 days to restore it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा हटाने के लिए निर्धारित है और 30 दिनों के बाद मिटा दिया जाएगा। इसे पुनः प्राप्त करने के लिए 30 दिनों के भीतर साइन इन करें।"
          }
        }
      }
    },
    "account.delete.confirm.action": {
      "comment": "Destructive confirm button in the deletion alert.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف الحساب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता हटाएँ"
          }
        }
      }
    },
    "account.delete.confirm.cancel": {
      "comment": "Cancel button in the deletion alert.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاحتفاظ بحسابي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep my account"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरा खाता रखें"
          }
        }
      }
    },
    "account.delete.confirm.message": {
      "comment": "Message of the deletion confirmation alert. States the grace period rather than implying the loss is instant.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُجدوَل مصروفاتك وتقاريرك وتقدّمك في التعلّم للحذف. لديك 30 يومًا لتغيير رأيك بتسجيل الدخول مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your expenses, reports and learning progress will be scheduled for deletion. You have 30 days to change your mind by signing in again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खर्च, रिपोर्ट और सीखने की प्रगति हटाने के लिए निर्धारित हो जाएँगे। दोबारा साइन इन करके अपना मन बदलने के लिए आपके पास 30 दिन हैं।"
          }
        }
      }
    },
    "account.delete.confirm.title": {
      "comment": "Title of the deletion confirmation alert.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف حسابك؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your account?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना खाता हटाएँ?"
          }
        }
      }
    },
    "account.detail.unavailable": {
      "comment": "On a pushed settings page whose payload has gone — a write that failed offline replaced it. One sentence and the back button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارجع وأعد تحميل حسابك لرؤية ذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back and reload your account to see this."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे देखने के लिए वापस जाएँ और अपना खाता फिर से लोड करें।"
          }
        }
      }
    },
    "account.empty": {
      "comment": "The account's `LoadState.empty` copy. `isEmpty` is `false` — a signed-in user always has an account — so this is only reachable if the server answers with no screen at all.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر علينا قراءة تفاصيل حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not read your account details."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपके खाते का विवरण नहीं पढ़ सके।"
          }
        }
      }
    },
    "account.eyebrow": {
      "comment": "`.topbar .eyebrow` on Account.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "HisaabWise"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HisaabWise"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HisaabWise"
          }
        }
      }
    },
    "account.language.blurb": {
      "comment": "`.explain` over the language list — the design's own sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُكتب كل شاشة وكل تسمية وكل تقرير باللغة التي تختارها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every screen, label and report will be written in the language you pick."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर स्क्रीन, लेबल और रिपोर्ट आपके चुनी हुई भाषा में लिखी जाएगी।"
          }
        }
      }
    },
    "account.language.search": {
      "comment": "The language list's search placeholder. Two shipped languages do not clear the twelve-row threshold, so it is not drawn — it is here because the component takes one.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن لغة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search language"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा खोजें"
          }
        }
      }
    },
    "account.language.title": {
      "comment": "The Language page's navigation title.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللغة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा"
          }
        }
      }
    },
    "account.notice.currencyChanged": {
      "comment": "The toast after `PUT /v1/me/currency` lands and every screen has been re-read.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر جميع المبالغ الآن بعملتك الجديدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every amount now shows in your new currency."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब हर राशि आपकी नई मुद्रा में दिखती है।"
          }
        }
      }
    },
    "account.notice.languageChanged": {
      "comment": "The toast after a language switch lands.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح التطبيق الآن بلغتك الجديدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is now in your new language."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप अब आपकी नई भाषा में है।"
          }
        }
      }
    },
    "account.notice.passwordChanged": {
      "comment": "The toast after `POST /v1/me/password` lands. The design's own wording.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديث كلمة المرور. استخدمها في المرة القادمة عند تسجيل الدخول."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password updated. Use it next time you sign in."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड अपडेट हो गया। अगली बार साइन इन करते समय इसका उपयोग करें।"
          }
        }
      }
    },
    "account.notice.personalUpdated": {
      "comment": "The toast after `PUT /v1/me` lands. The design's own wording.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديث المعلومات الشخصية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal information updated."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यक्तिगत जानकारी अपडेट हो गई।"
          }
        }
      }
    },
    "account.password.back": {
      "comment": "VoiceOver's reading of the step bar's back affordance.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوة إلى الوراء"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back a step"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक कदम पीछे"
          }
        }
      }
    },
    "account.password.check": {
      "comment": "The button on step two — the design's own words.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من إجاباتي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check my answers"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरे उत्तर जाँचें"
          }
        }
      }
    },
    "account.password.continue": {
      "comment": "The button on step one — the design's own word.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متابعة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखें"
          }
        }
      }
    },
    "account.password.current.blurb": {
      "comment": "`.step-p` on step one — the design's own sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع هذا أي شخص يمسك بهاتفك غير المقفل من الاستيلاء على الحساب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stops anyone who picks up your unlocked phone from taking over the account."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह किसी को भी, जो आपका अनलॉक फ़ोन उठा ले, खाता अपने कब्ज़े में लेने से रोकता है।"
          }
        }
      }
    },
    "account.password.current.field": {
      "comment": "The label on the current-password box.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور الحالية"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current password"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान पासवर्ड"
          }
        }
      }
    },
    "account.password.current.heading": {
      "comment": "`.step-h` on step one — the design's own words.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أولًا، أدخل كلمة المرور الحالية"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First, enter your current password"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले, अपना वर्तमान पासवर्ड दर्ज करें"
          }
        }
      }
    },
    "account.password.error.answerMissing": {
      "comment": "Under the answers when one is blank — the design's own words.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى الإجابة عن السؤالين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please answer both questions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया दोनों प्रश्नों के उत्तर दें।"
          }
        }
      }
    },
    "account.password.error.answersRejected": {
      "comment": "The server's `SECURITY_ANSWERS_INVALID`. It does not say **which** answer missed, because the server does not — telling somebody which of two guesses landed is a hint to whoever is guessing.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يطابق ذلك ما حفظته. حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That does not match what you saved. Have another go."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके सहेजे गए उत्तर से मेल नहीं खाता। एक बार फिर कोशिश करें।"
          }
        }
      }
    },
    "account.password.error.currentMissing": {
      "comment": "Under the current-password box when it is blank — the design's own words.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى إدخال كلمة المرور الحالية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter your current password."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया अपना वर्तमान पासवर्ड दर्ज करें।"
          }
        }
      }
    },
    "account.password.error.currentRejected": {
      "comment": "The server's `INVALID_CREDENTIALS`, as a sentence under the box it is about.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه ليست كلمة مرورك الحالية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not your current password."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपका वर्तमान पासवर्ड नहीं है।"
          }
        }
      }
    },
    "account.password.error.mismatch": {
      "comment": "Under the confirmation box when the two disagree — the design's own words.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكلمتان غير متطابقتين بعد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These two don't match yet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये दोनों अभी मेल नहीं खाते।"
          }
        }
      }
    },
    "account.password.error.tooShort": {
      "comment": "Under the new-password box when it is under eight characters (invariant 4) — the design's own words.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم 8 أحرف على الأقل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least 8 characters."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम 8 वर्णों का उपयोग करें।"
          }
        }
      }
    },
    "account.password.new.blurb": {
      "comment": "`.step-p` on step three — the design's own sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كلمة لا تستخدمها في أي مكان آخر. ثمانية أحرف كحد أدنى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick something you don't use anywhere else. Eight characters minimum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ ऐसा चुनें जो आप कहीं और उपयोग न करते हों। कम से कम आठ वर्ण।"
          }
        }
      }
    },
    "account.password.new.confirm": {
      "comment": "The label on the confirmation box.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكيد كلمة المرور الجديدة"
          }
        },
        "en": {
          "stringUnit": {
