{
  "sourceLanguage": "en",
  "strings": {
    "article.empty": {
      "comment": "Shown when an article body arrives with no sections — a title over white space looks broken in a way the empty state does not.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This article has nothing in it yet."
          }
        }
      }
    },
    "article.sources.caption": {
      "comment": "Caption above an article's source links. Official sources only — this is education, not regulated advice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources"
          }
        }
      }
    },
    "article.sources.hint": {
      "comment": "VoiceOver hint on a source link.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the source in your browser"
          }
        }
      }
    },
    "article.step.accessibilityLabel %@ %@": {
      "comment": "VoiceOver label for one numbered step in an article: %1$@ is its position and %2$@ the total. The step's words are its value.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$@ of %2$@"
          }
        }
      }
    },
    "component.button.inFlight": {
      "comment": "Read as a button's accessibility value while its action is in flight. The spinner that replaces the label is invisible to VoiceOver, so without this the control goes silent exactly when it is busy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In progress"
          }
        }
      }
    },
    "component.combo.hint": {
      "comment": "VoiceOver hint on a picker trigger — the design's aria-haspopup=\"listbox\", said in words.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a list to choose from"
          }
        }
      }
    },
    "component.field.revealPassword": {
      "comment": "The eye button inside a password field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show password"
          }
        }
      }
    },
    "component.lesson.close": {
      "comment": "The close affordance in the lesson player's header. Icon-only, so this is the whole of what VoiceOver reads. The design's own aria-label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close lesson"
          }
        }
      }
    },
    "component.lesson.hint.locked": {
      "comment": "VoiceOver hint on a locked lesson. It is pressable and refuses with a sentence, so the hint says so before the reader presses it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked until you finish the lesson before it"
          }
        }
      }
    },
    "component.lesson.hint.next": {
      "comment": "VoiceOver hint on the lesson the reader should do next. It is the only reading of the START flag on the path, which is hidden from VoiceOver because it is a second element about the node beside it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start here. Starts the lesson"
          }
        }
      }
    },
    "component.lesson.hint.open": {
      "comment": "VoiceOver hint on a lesson the reader can start.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts the lesson"
          }
        }
      }
    },
    "component.money.accessibilityEmpty %@": {
      "comment": "VoiceOver value for an empty money field. %@ is the ISO currency code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No amount yet, in %@"
          }
        }
      }
    },
    "component.money.accessibilityValue %@ %@": {
      "comment": "VoiceOver value for a money field: %1$@ is the number typed, %2$@ the ISO currency code. Numbered so a language can put the code first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "component.phone.accessibilityValue %@ %@": {
      "comment": "VoiceOver value for the dial-code trigger: %1$@ is the dial code, %2$@ the ISO country code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "component.picker.clearSearch": {
