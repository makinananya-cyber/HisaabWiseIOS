        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप कभी अपने ईमेल और फ़ोन तक पहुँच खो दें, तो ये दो उत्तर ही हैं जिनसे हम जानते हैं कि यह सचमुच आप हैं।"
          }
        }
      }
