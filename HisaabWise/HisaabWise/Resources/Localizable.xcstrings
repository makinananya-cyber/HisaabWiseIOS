        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least 8 characters."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम 8 वर्णों का उपयोग करें।"
          }
        }
      }
    },
    "recovery.error.passwordsDiffer": {
      "comment": "Recovery step 3 where the two boxes do not match.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكلمتان غير متطابقتين."
