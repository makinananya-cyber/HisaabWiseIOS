      "comment": "Body of the log out confirmation dialog.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى بياناتك آمنة. ستحتاج إلى كلمة مرورك لتسجيل الدخول مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays safe. You'll need your password to sign back in."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा सुरक्षित रहता है। वापस साइन इन करने के लिए आपको अपने पासवर्ड की ज़रूरत होगी।"
          }
        }
      }
    },
