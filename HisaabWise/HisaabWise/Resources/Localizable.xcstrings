      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا بأس — الأسئلة الصعبة هي التي تستحق التكرار. أعد الدرس مرة أخرى وسيرسخ في ذهنك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's alright — the tricky ones are the ones worth repeating. Run the lesson again and it will stick."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई बात नहीं — मुश्किल सवाल ही दोहराने लायक होते हैं। पाठ को दोबारा करें और यह ज़हन में बैठ जाएगा।"
          }
