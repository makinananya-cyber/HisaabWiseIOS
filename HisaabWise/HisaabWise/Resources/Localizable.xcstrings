          }
        }
      }
    },
    "recovery.identity.blurb": {
      "comment": "Blurb of recovery step 2. Says plainly that all three factors are needed, because there is no OTP or email verification in this product.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تهم حالة الأحرف ولا الصياغة الدقيقة — يكفي أن تصيب الكلمات الأساسية. ونحتاج أيضًا إلى تاريخ ميلادك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capital letters and exact wording do not matter — just get the key words right. Your date of birth is needed too."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बड़े-छोटे अक्षर और सटीक शब्दावली मायने नहीं रखती — बस मुख्य शब्द सही रखें। आपकी जन्मतिथि भी चाहिए।"
          }
        }
      }
    },
    "recovery.identity.dob.label": {
      "comment": "Date-of-birth field label during recovery.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تاريخ الميلاد"
          }
        },
