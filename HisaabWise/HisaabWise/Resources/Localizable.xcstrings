    "shell.verifyEmail": {
      "comment": "The strip above the tabs for an account whose email is not verified yet. Not a gate — the app is fully usable; ADR-0008's foreground revalidation is what makes it disappear.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من بريدك الوارد وأكّد عنوان بريدك الإلكتروني."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your inbox and verify your email address."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना इनबॉक्स जाँचें और अपना ईमेल पता सत्यापित करें।"
          }
        }
      }
    },
    "signin.action": {
      "comment": "Sign-in submit button.",
      "extractionState": "manual",
