            "value": "साइन इन करें"
          }
        }
      }
    },
    "signin.email.label": {
      "comment": "Sign-in email field label. [FIX] Product Spec §3.2 — the design asked for a username, which registration never collects.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البريد الإلكتروني"
