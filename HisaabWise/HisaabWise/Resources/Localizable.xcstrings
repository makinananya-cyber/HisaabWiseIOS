          }
        }
      }
    },
    "recovery.error.dateOfBirthMissing": {
      "comment": "Recovery step 2 with no date of birth chosen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تاريخ ميلادك."
