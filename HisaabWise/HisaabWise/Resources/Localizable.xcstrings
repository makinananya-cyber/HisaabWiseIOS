    "home.savings.foot.met %@": {
      "comment": "The savings foot line once the goal is met. %@ is the server-formatted saved figure.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد ادّخرت %@ — كامل هدفك وأكثر قليلًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have saved %@ — your whole goal, and a little more."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने %@ बचाया है — आपका पूरा लक्ष्य, और थोड़ा अधिक।"
          }
        }
      }
    },
    "home.savings.foot.nothing": {
      "comment": "The savings foot line when nothing has been saved. The design named a figure here; the client has no formatter to invent one, so the sentence does not.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تدّخر شيئًا بعد هذا الشهر. حتى المبلغ الصغير يحرّك المؤشر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing set aside yet this month. Even a small amount moves the pin."
          }
        },
        "hi": {
          "stringUnit": {
