    "registration.three.goal.label": {
      "comment": "Registration step 3 field label.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هدف الادخار الشهري"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly savings goal"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मासिक बचत लक्ष्य"
          }
        }
      }
    },
    "registration.three.hint.above %@": {
      "comment": "The hint when the typed goal is above the suggestion. %@ is the whole-number percentage.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا %@%% من راتبك — أعلى من قاعدة الـ 20%%. رائع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's %@%% of your salary — ahead of the 20%% rule. Nice."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके वेतन का %@%% है — 20%% के नियम से आगे। बढ़िया।"
          }
        }
      }
    },
    "registration.three.hint.below %@": {
      "comment": "The hint when the typed goal is below the suggestion. %@ is the whole-number percentage.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا %@%% من راتبك — أقل قليلًا من قاعدة الـ 20%%، لكن البداية بداية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's %@%% of your salary — a little under the 20%% rule, but a start is a start."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके वेतन का %@%% है — 20%% के नियम से थोड़ा कम, पर शुरुआत तो शुरुआत है।"
          }
        }
      }
    },
    "registration.three.hint.empty": {
      "comment": "The hint under the goal field when nothing has been typed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك هذا فارغًا واضغط تخطٍّ الآن لاستخدام المبلغ المقترح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this blank and tap Skip for now to use the suggested amount."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे खाली छोड़ें और सुझाई गई राशि उपयोग करने के लिए अभी के लिए छोड़ें पर टैप करें।"
          }
        }
      }
    },
    "registration.three.hint.onTarget %@": {
      "comment": "The hint when the typed goal is exactly the suggestion. %@ is the whole-number percentage.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا %@%% من راتبك — مطابق تمامًا للقاعدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's %@%% of your salary — right on the rule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके वेतन का %@%% है — नियम के बिल्कुल अनुसार।"
          }
        }
      }
    },
    "registration.three.perMonth": {
      "comment": "Follows the suggested figure on the statement card.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شهريًا"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a month"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति माह"
          }
        }
      }
    },
    "registration.three.rule.body": {
      "comment": "Body of the 20% statement card.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاعدة مجرّبة جيدًا هي ادخار 20% من راتبك كل شهر. بناءً على الراتب الذي أدخلته، يبلغ ذلك:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A well-tested rule of thumb is to put 20% of your salary towards savings each month. Based on the salary you gave us, that comes to:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अच्छी तरह से आज़माया गया नियम है कि हर महीने अपने वेतन का 20% बचत में डालें। आपने जो वेतन बताया, उसके आधार पर यह बनता है:"
          }
        }
      }
    },
    "registration.three.rule.eyebrow": {
      "comment": "Eyebrow on the statement card explaining the suggested savings goal.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاعدة الـ 20%"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 20% rule"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "20% का नियम"
          }
        }
      }
    },
    "registration.three.rule.footer": {
      "comment": "Footer of the 20% statement card.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت راضيًا عن هذا المبلغ، أدخله أدناه. وإلا فأدخل قيمة خاصة بك — يمكنك تغييرها في أي وقت من حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you're happy with this amount, put it in below. Otherwise enter a value of your own — you can change it any time from your account."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप इस राशि से संतुष्ट हैं, तो इसे नीचे डालें। अन्यथा अपनी कोई राशि दर्ज करें — आप इसे अपने खाते से किसी भी समय बदल सकते हैं।"
          }
        }
      }
    },
    "registration.three.skip": {
      "comment": "Creates the account with the suggested goal, recorded as not chosen by the user.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخطٍّ الآن"
