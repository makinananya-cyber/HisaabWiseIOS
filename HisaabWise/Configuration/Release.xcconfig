// Release — production (workspace Rule 2, ADR-0010).
//
// This is the configuration the **"Release"** scheme builds and archives: the shipping
// build, pointed at the production backend.
//
// The base URL is the bare **origin** — `APIClient` hangs `/v1/...` off it (APIClient.swift), and
// `/health` is the backend's health probe, not the API root, so it must not appear here.
//
// `//` opens a comment in an .xcconfig; `$()` expands to nothing and breaks the token up.
HW_API_BASE_URL = https:/$()/hisaabwise-backend-0l9b.onrender.com

// No ATS exception: production is HTTPS. Only `Info-Debug.plist` carries one.
INFOPLIST_FILE = Configuration/Info.plist

// The hosted legal pages (Rule 7 — placeholder domain until the owner's Cloudflare credentials arrive).
HW_TERMS_URL = https:/$()/hisaabwise.invalid/terms
HW_PRIVACY_URL = https:/$()/hisaabwise.invalid/privacy
