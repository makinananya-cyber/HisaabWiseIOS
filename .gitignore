# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Xcode — user-specific state
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.xcscmblueprint
*.xccheckout

# Xcode — build products
build/
# The result bundle the CI command writes (ADR-0028). Running that command locally
# leaves one in the same place.
*.xcresult
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcarchive

# Swift Package Manager — no package in the tree today (ADR-0018), but any that
# arrives keeps its Package.resolved committed, to pin dependency versions
# (see docs/adr/0013-testing-and-previews.md).
.build/
.swiftpm/xcode/package.xcworkspace/xcuserdata/
.swiftpm/configuration/

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Signing material — never committed (ADR-0010, Rule 3: secrets live in GitHub
# secrets and Cloudflare per-environment secrets, never in the repo)
*.mobileprovision
*.p12
*.cer
*.certSigningRequest
*.p8
AuthKey_*.p8

# Local overrides
*.local.xcconfig
.env
